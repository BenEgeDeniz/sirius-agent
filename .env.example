# ============================================================
# BenEgeDeniz Sirius Agent - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# On the production server, these are stored in /etc/sirius-agent/env
# and loaded by systemd EnvironmentFile directive.
# ============================================================

# ---- Redis ----
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=           # Generated by install.sh
REDIS_DB=0

# ---- API Authentication ----
# Comma-separated API keys. Generate with: scripts/generate-key.sh
API_KEYS=                 # REQUIRED - at least one key

# ---- Domain ----
# The wildcard base domain (without the *. prefix)
# Example: agent.example.com
BASE_DOMAIN=              # REQUIRED

# ---- Upstream ----
# The internal upstream URL (Plesk server via Tailscale)
# Example: https://upstream-server:8443
UPSTREAM_URL=             # REQUIRED

# ---- Server ----
# API listen address (should be localhost, OpenResty proxies to it)
LISTEN_ADDR=127.0.0.1:8181

# ---- Tunnel Limits ----
# Maximum number of concurrent tunnels
MAX_TUNNELS=50
# Minimum tunnel duration in minutes
MIN_TUNNEL_DURATION=1
# Maximum tunnel duration in minutes (-1 for unlimited)
MAX_TUNNEL_DURATION=1440

# ---- Rate Limiting ----
# API requests per minute per IP
RATE_LIMIT_RPM=30
# Proxy (OpenResty) requests per minute per IP
PROXY_RATE_LIMIT_RPM=600

# ---- Logging ----
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ---- TLS ----
# DNS provider for certbot wildcard certificate
# Supported: cloudflare, digitalocean, route53, manual
DNS_PROVIDER=cloudflare

# Path to DNS provider API credentials file (for certbot)
# Example for Cloudflare: /etc/sirius-agent/cloudflare.ini
DNS_CREDENTIALS_FILE=/etc/sirius-agent/dns-credentials.ini
